PORT=3847
HOST=127.0.0.1
# Répertoires listés dans le sélecteur (chemins absolus, séparés par des virgules)
WORKSPACE_ROOTS=/home/you/dev,/home/you/projects
# Commande lancée à l’ouverture d’une session (shell -lc)
CLAUDE_COMMAND=claude
# true = ouvrir un shell bash puis la commande ; false = lancer la commande directement
USE_LOGIN_SHELL=true
# Préfixe public si l'app est servie sous /claude/ (nginx). Obligatoire si le proxy retire le préfixe.
ROOT_PATH=/claude
# true seulement si nginx transmet /claude/... à uvicorn sans le retirer (proxy_pass sans slash final)
MOUNT_AT_ROOT_PATH=false
